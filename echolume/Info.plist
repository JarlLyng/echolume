<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Partial Info.plist, merged with the keys Xcode generates
	  (GENERATE_INFOPLIST_FILE = YES). SentryDSN must live in a real Info.plist:
	  Xcode's generated plist only honours INFOPLIST_KEY_* settings that map to
	  Apple's own keys, so INFOPLIST_KEY_SentryDSN was silently dropped. The value
	  comes from SENTRY_DSN (gitignored Sentry.xcconfig), expanded at build time.
	-->
	<key>SentryDSN</key>
	<string>$(SENTRY_DSN)</string>
</dict>
</plist>
